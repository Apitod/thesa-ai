# ============================================================
# THESA AI — Production Environment Variables
# Copy this file to .env before deploying: cp .env.example .env
# ============================================================

# Server Port (default: 8080)
PORT=8080

# ------------------------------------------------------------
# AI / LLM Multi-Provider Connectivity (DeepSeek & Gemini)
# ------------------------------------------------------------
# Primary provider: "deepseek" or "gemini" (Auto-failover enabled)
AI_PRIMARY_PROVIDER=deepseek

# DeepSeek AI API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# Payment Gateway (Midtrans Snap & Core QRIS)
# ------------------------------------------------------------
# Set to "true" for production Midtrans, "false" for Sandbox
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_MERCHANT_ID=G123456789

# Webhook secret or notification verification
MIDTRANS_WEBHOOK_URL=https://yourdomain.com/api/v1/payment/webhook

# ------------------------------------------------------------
# Database Configuration (MySQL 8.0+)
# ------------------------------------------------------------
# Option 1: Full DSN format (Used by Docker Compose / Custom VPS)
MYSQL_DSN=root:thesapassword@tcp(thesa-db:3306)/risethub?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# Option 2: Cloud PaaS URL format (Used by Railway, Render, Fly.io, PlanetScale, Aiven)
# DATABASE_URL=mysql://user:password@host.cloud.com:3306/risethub?parseTime=true

# Database password (used when spinning up standalone MySQL container)
MYSQL_ROOT_PASSWORD=thesapassword
DB_PORT=3306

# ------------------------------------------------------------
# Security & Administrative Controlling Settings
# ------------------------------------------------------------
ADMIN_SECRET_KEY=thesa_super_admin_jwt_secret_2026_change_in_prod
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
